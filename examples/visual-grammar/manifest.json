      {
        "id": "architecture",
        "reader_question": "组件如何连接、分支与汇合？",
        "core_judgment": "架构图法呈现组件关系",
        "subtitle": "依赖、分支与汇合",
        "grammar": "architecture",
        "must_show": [
          "上游组件",
          "核心组件",
          "两个下游分支",
          "一个汇合点"
        ]
      },
      {
        "id": "hierarchy",
        "reader_question": "整体如何分成类别与子类？",
        "core_judgment": "层级图法呈现父子关系",
        "subtitle": "从整体到子类",
        "grammar": "hierarchy",
        "must_show": [
          "一个根节点",
          "两类子节点",
          "末级成员"
        ]
      },
      {
        "id": "flow",
        "reader_question": "输入如何经过步骤成为输出？",
        "core_judgment": "流程图法呈现先后步骤",
        "subtitle": "从输入到输出",
        "grammar": "flow",
        "must_show": [
          "输入",
          "三个顺序步骤",
          "输出"
        ]
      },
      {
        "id": "loop",
        "reader_question": "行动如何回到下一轮改进？",
        "core_judgment": "循环图法呈现反馈迭代",
        "subtitle": "结果回到下一轮",
        "grammar": "loop",
        "must_show": [
          "观察",
          "行动",
          "反馈",
          "回到观察"
        ]
      },
      {
        "id": "decision-tree",
        "reader_question": "条件如何导向不同路径？",
        "core_judgment": "决策树呈现条件选择",
        "subtitle": "条件决定下一步",
        "grammar": "decision_tree",
        "must_show": [
          "一个条件问题",
          "是与否分叉",
          "两个不同结果"
        ]
      },
      {
        "id": "comparison",
        "reader_question": "两个方案的差别如何一眼可见？",
        "core_judgment": "对比图法呈现可见差异",
        "subtitle": "左右结构必须不同",
        "grammar": "comparison",
        "comparison_basis": [
          "左侧为线性单一路径",
          "右侧为并行分组路径"
        ],
        "must_show": [
          "方案A线性路径",
          "方案B并行分组",
          "可见结构差异"
        ]
      },
      {
        "id": "matrix",
        "reader_question": "对象如何按两个独立维度定位？",
        "core_judgment": "矩阵图法呈现双维定位",
        "subtitle": "两个维度共同分类",
        "grammar": "matrix",
        "must_show": [
          "横轴",
          "纵轴",
          "四个不同位置"
        ]
      },
      {
        "id": "overlap-map",
        "reader_question": "两部分的共同与独有内容是什么？",
        "core_judgment": "交集图法呈现共存关系",
        "subtitle": "交集与差异同时可见",
        "grammar": "overlap_map",
        "must_show": [
          "左侧独有部分",
          "右侧独有部分",
          "中间交集"
        ]
      },
      {
        "id": "boundary-map",
        "reader_question": "什么在范围内，什么在范围外？",
        "core_judgment": "边界图法呈现所属范围",
        "subtitle": "包含与排除清晰分开",
        "grammar": "boundary_map",
        "must_show": [
          "一个范围边界",
          "范围内对象",
          "范围外对象"
        ]
      },
      {
        "id": "argument-map",
        "reader_question": "结论由哪些依据支持，又受何种限制？",
        "core_judgment": "论证图法呈现主张结构",
        "subtitle": "依据、限制与结论",
        "grammar": "argument_map",
        "must_show": [
          "一个主张",
          "两个依据",
          "一个限制",
          "一个结论"
        ]
      },
      {
        "id": "timeline",
        "reader_question": "真实时间推进中发生了哪些阶段？",
        "core_judgment": "时间线呈现阶段推进",
        "subtitle": "按时间顺序阅读",
        "grammar": "timeline",
        "must_show": [
          "起点年份",
          "中间阶段",
          "终点年份"
        ]
      },
      {
        "id": "continuum",
        "reader_question": "对象处在非时间的渐进位置哪里？",
        "core_judgment": "连续谱呈现渐进位置",
        "subtitle": "不是时间进程",
        "grammar": "continuum",
        "must_show": [
          "低端",
          "中间位置",
          "高端"
        ]
      },
      {
        "id": "layer-stack",
        "reader_question": "不同抽象层如何叠放与包含？",
        "core_judgment": "层叠图法呈现系统层次",
        "subtitle": "上层建立在下层之上",
        "grammar": "layer_stack",
        "must_show": [
          "基础层",
          "能力层",
          "体验层"
        ]
      }
    ]
  },
